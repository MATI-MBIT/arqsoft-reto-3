        <mxCell id="n3" value="&lt;b&gt;Coreografía&lt;/b&gt;: el Motor publica «RegistroUnificado»; Consolidación financiera y Venta cruzada reaccionan sin conocer las fuentes." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=10;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" parent="1">
