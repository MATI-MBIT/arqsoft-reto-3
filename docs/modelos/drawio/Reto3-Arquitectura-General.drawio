        <mxCell id="J8XGVkjkDiiO3JkaVJE3-63" value="&lt;b&gt;Medida ASR-M01&lt;/b&gt;&lt;br&gt;1 componente nuevo (regla v2)&lt;br&gt;0 componentes existentes modificados&lt;br&gt;en producción ≤ 3 días (media) · reversión ≤ 5 min" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=10;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" parent="1">
