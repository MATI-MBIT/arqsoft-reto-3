        <mxCell id="8zOs3h5oDShpTiZB3nxK-50" value="&lt;b&gt;Wrapper / capa anticorrupción&lt;/b&gt;: el modelo del proveedor X (campos, códigos, moneda) se traduce dentro del conector y nunca entra al núcleo." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=10;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" parent="1">
