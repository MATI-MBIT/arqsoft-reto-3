        <mxCell id="8zOs3h5oDShpTiZB3nxK-54" value="&lt;b&gt;Descubrimiento&lt;/b&gt;: el conector se da de alta por configuración en el registro; los consumidores solo conocen el tópico canónico, no la fuente." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=10;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" parent="1">
