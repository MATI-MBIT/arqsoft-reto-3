        <mxCell id="J8XGVkjkDiiO3JkaVJE3-59" value="&lt;b&gt;Strategy + inversión de dependencias&lt;/b&gt;: el Motor define IReglaInterpretacion y depende solo de ella; un algoritmo nuevo es un plug-in nuevo (abierto/cerrado)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=10;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" parent="1">
