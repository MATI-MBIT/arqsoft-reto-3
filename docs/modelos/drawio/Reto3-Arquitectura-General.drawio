        <mxCell id="J8XGVkjkDiiO3JkaVJE3-61" value="&lt;b&gt;Binding diferido y reversible&lt;/b&gt;: la versión activa se lee de configuración en caliente; revertir es reactivar v1, sin redesplegar (lección Knight Capital)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=10;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" parent="1">
