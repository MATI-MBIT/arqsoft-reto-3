          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;Contrato explícito&lt;/b&gt;: el esquema canónico versionado cierra las distancias sintáctica y semántica (unidades, moneda, códigos); lo no conforme va a cuarentena." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8DC;strokeColor=#B9A65A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=10;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" parent="1">
