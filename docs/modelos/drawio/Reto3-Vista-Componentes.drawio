ent="cuar"><mxGeometry x="8" y="-9" width="36" height="16" as="geometry" /></mxCell><mxCell id="motor__asr2" value="M01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5B3F8C;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#5B3F8C;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="motor"><mxGeometry x="8" y="-9" width="36" height="16" as="geometry" /></mxCell><mxCell id="mdm__asr1" value="I02" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#2C7873;strokeColor=#2C7873;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="mdm"><mxGeometry x="8" y="-9" width="36" height="16" as="geometry" /></mxCell><mxCell id="reglas__asr2" value="M01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#5B3F8C;strokeColor=#5B3F8C;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="reglas"><mxGeometry x="8" y="-9" width="36" height="16" as="geometry" /></mxCell><mxCell id="config__asr2" value="M01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#5B3F8C;strokeColor=#5B3F8C;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="config"><mxGeometry x="8" y="-9" width="36" height="16" as="geometry" /></mxCell><mxCell id="repo__asr1" value="I02" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2C7873;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#2C7873;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="repo"><mxGeometry x="8" y="-9" width="36" height="16" as="geometry" /></mxCell><mxCell id="registro__asr0" value="I01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="registro"><mxGeometry x="8" y="-9" width="36" height="16" as="geometry" /></mxCell><mxCell id="registro__asr1" value="I02" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#2C7873;strokeColor=#2C7873;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="registro"><mxGeometry x="48" y="-9" width="36" height="16" as="geometry" /></mxCell><mxCell id="registro__asr3" value="M02" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9A5B13;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#9A5B13;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="registro"><mxGeometry x="88" y="-9" width="36" height="16" as="geometry" /></mxCell><mxCell id="leyenda__lg" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;bola dentro del semicírculo: ensamble entre quien &lt;b&gt;provee&lt;/b&gt; la interfaz y quien la &lt;b&gt;requiere&lt;/b&gt;&lt;br&gt;línea continua sin flecha: conector&lt;br&gt;- - -&amp;gt; punteada con flecha abierta: dependencia, con su estereotipo («use», «publish»…)&lt;br&gt;«external»: sistema fuera de nuestro control&lt;br&gt;caja gris: sistema externo&lt;br&gt;borde punteado: lo que se agrega a futuro&lt;br&gt;«subsystem»: la frontera del sistema; fuera de ella, los externos y los actores&lt;br&gt;carpeta: paquete, agrupa los componentes por capa&lt;br&gt;nota amarilla: la decisión, con su título en negrita, atada con punteada a su elemento" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40.0" y="1578.8" width="560" height="235" as="geometry" /></mxCell><mxCell id="leyenda__cv" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40.0" y="1831.8" width="560" height="140" as="geometry" /></mxCell><mxCell id="leyenda__cv__b0" value="I01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="28" width="36" height="16" as="geometry" /></mxCell><mxCell id="leyenda__cv__t0" value="Integrar empresa adquirida" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="54" y="26" width="225" height="20" as="geometry" /></mxCell><mxCell id="leyenda__cv__b1" value="I02" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#2C7873;strokeColor=#2C7873;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="287" y="28" width="36" height="16" as="geometry" /></mxCell><mxCell id="leyenda__cv__t1" value="Mismo significado de los datos" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="329" y="26" width="225" height="20" as="geometry" /></mxCell><mxCell id="leyenda__cv__b2" value="M01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#5B3F8C;strokeColor=#5B3F8