 x="2321" y="1339" width="39" height="60" as="geometry"/></mxCell><mxCell id="a_ana" value="Analista de datos" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#FFFFFF;strokeColor=#2B3642;fila=C4;disposicion=declarada;" vertex="1" parent="1"><mxGeometry x="2613" y="429" width="39" height="60" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;Modelo canónico&lt;/b&gt;: cada conector traduce&lt;br&gt;su sistema al modelo de la holding (2·N&lt;br&gt;traducciones, no N·(N−1) punto a punto).&lt;br&gt;El modelo ajeno nunca entra al núcleo." style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;disposicion=declarada;" vertex="1" parent="1"><mxGeometry x="39" y="910" width="286" height="70.8" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Reglas como estrategias&lt;/b&gt;: cada algoritmo de&lt;br&gt;interpretación es un plug-in que implementa&lt;br&gt;IReglaInterpretacion; la versión activa se elige&lt;br&gt;por configuración, sin recompilar el Motor." style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1"><mxGeometry x="2546" y="609.1" width="253.2" height="70.8" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Coreografía&lt;/b&gt;: el Motor publica&lt;br&gt;«RegistroUnificado»; Consolidación&lt;br&gt;financiera y Venta cruzada&lt;br&gt;reaccionan sin conocer las fuentes." style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;" vertex="1" parent="1"><mxGeometry x="2546" y="703.9" width="202" height="70.8" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Contrato explícito&lt;/b&gt;: el esquema canónico&lt;br&gt;versionado cierra las distancias sintáctica&lt;br&gt;y semántica (unidades, moneda,&lt;br&gt;códigos); lo no conforme va a cuarentena." style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;disposicion=declarada;" vertex="1" parent="1"><mxGeometry x="39" y="1118" width="286" height="70.8" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Contención del cambio (M02)&lt;/b&gt;: si una&lt;br&gt;empresa cambia su sistema, solo se&lt;br&gt;ajustan el mapeo y el traductor de su&lt;br&gt;conector; el contrato canónico, el núcleo,&lt;br&gt;la analítica y los informes no cambian." style="shape=note;html=1;size=12;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingRight=14;spacingTop=4;fillColor=#FFFDE7;strokeColor=#9A8B4F;fila=C11;disposicion=declarada;" vertex="1" parent="1"><mxGeometry x="39" y="1313" width="286" height="84" as="geometry"/></mxCell><mxCell id="r0" value="API REST" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;" edge="1" parent="1" source="c_eps" target="ext_eps"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="442" y="208.2"/><mxPoint x="311" y="208.2"/><mxPoint x="311" y="211.5"/><mxPoint x="299" y="211.5"/></Array><mxPoint x="-29.3" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r1" value="CDC / HL7" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;" edge="1" parent="1" source="c_ips" target="ext_ips"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="442" y="377.6"/><mxPoint x="299" y="377.6"/></Array><mxPoint x="-28.6" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r2" value="SOAP" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;strokeColor=#2B3642;fontColor=#1F2A36;" edge="1" parent="1" source="c_pr