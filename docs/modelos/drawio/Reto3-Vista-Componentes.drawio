ica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="740" width="560" height="184" as="geometry" /></mxCell><mxCell id="leyenda__cv" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="942" width="560" height="140" as="geometry" /></mxCell><mxCell id="leyenda__cv__b0" value="I01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="28" width="36" height="16" as="geometry" /></mxCell><mxCell id="leyenda__cv__t0" value="Integrar empresa adquirida" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="54" y="26" width="225" height="20" as="geometry" /></mxCell><mxCell id="leyenda__cv__b1" value="I02" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#2C7873;strokeColor=#2C7873;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="287" y="28" width="36" height="16" as="geometry" /></mxCell><mxCell id="leyenda__cv__t1" value="Mismo significado de los datos" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="329" y="26" width="225" height="20" as="geometry" /></mxCell><mxCell id="leyenda__cv__b2" value="M01" style="text;rounded=1;arcSize=30;html=1;whiteSpace