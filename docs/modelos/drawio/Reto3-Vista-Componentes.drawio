etica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="map"><mxGeometry x="48" y="-9" width="36" height="16" as="geometry"/></mxCell><mxCell id="val__asr0" value="I01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="val"><mxGeometry x="8" y="-9" width="36" height="16" as="geometry"/></mxCell><mxCell id="leyenda__lg" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;relleno ámbar: artefacto de un ASR (ahí se aplica la táctica o se hace el cambio)&lt;br&gt;marco ámbar pálido: contiene un artefacto de un ASR&lt;br&gt;borde ámbar: participa en la respuesta, pero no se modifica&lt;br&gt;carpeta o marco gris: agrupa, no es un elemento&lt;br&gt;azul: punto de contacto (interfaz, puerto o evento)&lt;br&gt;nota: la decisión, atada con punteada a su elemento&lt;br&gt;—○ la bola: interfaz que el componente &lt;b&gt;provee&lt;/b&gt;&lt;br&gt;—( el semicírculo: interfaz que el componente &lt;b&gt;requiere&lt;/b&gt;&lt;br&gt;□ sobre el borde: puerto, con su interfaz junto a él&lt;br&gt;elipse punteada: la táctica aplicada, atada con punteadas sin flecha a los roles que liga&lt;br&gt;«tactic» {id = …}: el elemento aplica esa táctica del catálogo" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=42;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="684.8" width="560" height="176" as="geometry"/></mxCell><mxCell id="leyenda__lg__m0" value="" style="text;html=1;fillColor=#FFF4D6;strokeColor=#B8860B;" vertex="1" connectable="0" parent="leyenda__lg"><mxGeometry x="10" y="22.2" width="24" height="14" as="geometry"/></mxCell><mxCell id="leyenda__lg__m1" value="" style="text;html=1;fill