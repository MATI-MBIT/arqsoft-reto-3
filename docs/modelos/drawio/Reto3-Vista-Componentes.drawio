="points"><mxPoint x="622.6" y="150" /><mxPoint x="622.6" y="78" /><mxPoint x="956.9" y="78" /></Array></mxGeometry></mxCell><mxCell id="n3__a0" value="" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1" source="n3" target="ct"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="217.6" y="308" /><mxPoint x="217.6" y="262" /><mxPoint x="809.7" y="262" /><mxPoint x="809.7" y="238" /></Array></mxGeometry></mxCell><mxCell id="ct__asr0" value="I01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="ct"><mxGeometry x="8" y="-9" width="36" height="16" as="geometry" /></mxCell><mxCell id="ct__asr1" value="I02" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#2C7873;strokeColor=#2C7873;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="ct"><mxGeometry x="48" y="-9" width="36" height="16" as="geometry" /></mxCell><mxCell id="rc__asr0" value="I01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="rc"><mxGeometry x="8" y="-9" width="36" height="16" as="geometry" /></mxCell><mxCell id="leyenda__lg" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;—○ la bola: interfaz que el componente &lt;b&gt;provee&lt;/b&gt;&lt;br&gt;bola dentro del semicírculo: ensamble entre quien &lt;b&gt;provee&lt;/b&gt; la interfaz y quien la &lt;b&gt;requiere&lt;/b&gt;&lt;br&gt;línea continua sin flecha: conector&lt;br&gt;- - -&amp;gt; punteada con flecha abierta: dependencia, con su estereotipo («use», «publish»…)&lt;br&gt;«event»: tema o cola; los publicadores le escriben y los suscriptores lo leen&lt;br&gt;«external»: sistema fuera de nuestro control&lt;br&gt;borde punteado: lo que se agrega a futuro&lt;br&gt;«tactic» {id = …}: el elemento aplica esa táctica del catálogo&lt;br&gt;nota: comentario atado con punteada a su elemento" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="509" width="560" height="218" as="geometry" /></mxCell><mxCell id="leyenda__cv" value="&lt;b&gt;Convención ASR&lt;/b&gt; · cada elemento lleva la insignia de los ASR en cuyo alcance está" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="1"><mxGeometry x="40" y="745" width="560" height="140" as="geometry" /></mxCell><mxCell id="leyenda__cv__b0" value="I01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="28" width="36" height="16" as="geometry" /></mxCell><mxCell id="leyenda__cv__t0" value="Integrar empresa adquirida" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="54" y="26" width="225" height="20" as="geometry" /></mxCell><mxCell id="leyenda__cv__b1" value="I02" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#2C7873;strokeColor=#2C7873;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="287" y="28" width="36" height="16" as="geometry" /></mxCell><mxCell id="leyenda__cv__t1" value="Mismo significado de los datos" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="329" y="26" width="225" height="20" as="geometry" /></mxCell><mxCell id="leyenda__cv__b2" value="M01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#5B3F8C;strokeColor=#5B3F8C;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="52" width="36" height="16" as="geometry" /></mxCell><mxCell id="leyenda__cv__t2" value="Cambiar algoritmo de interpretación" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="54" y="50" width="225" height="20" as="geometry" /></mxCell><mxCell id="leyenda__cv__b3" value="M02" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#9A5B13;strokeColor=#9A5B13;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="287" y="52" width="36" height="16" as="geometry" /></mxCell><mxCell id="leyenda__cv__t3" value="Cambio en sistema de una empresa" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="329" y="50" width="225" height="20" as="geometry" /></mxCell><mxCell id="leyenda__cv__fa" value="I01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="88" width="36" height="16" as="geometry" /></mxCell><mxCell id="leyenda__cv__fat" value="&lt;b&gt;relleno&lt;/b&gt;: artefacto del ASR (ahí se aplica la táctica o se hace el cambio)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="54" y="86" width="500" height="20" as="geometry" /></mxCell><mxCell id="leyenda__cv__fp" value="I01" style="text;rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;strokeWidth=1.3;dashed=1;dashPattern=3 2;fontColor=#1F4E79;fontStyle=1;fontSize=9;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="12" y="112" width="36" height="16" as="geometry" /></mxCell><mxCell id="leyenda__cv__fpt" value="&lt;b&gt;contorno punteado&lt;/b&gt;: participa en la respuesta, pero no se modifica" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vertex="1" connectable="0" parent="leyenda__cv"><mxGeometry x="54" y="110" width="500" height="20" as="geometry" /></mxCell><mxCell id="leyenda__traz" value="&lt;b style=&quot;font-size:13px&quot;&gt;Trazabilidad ASR → elementos de la arquitectura&lt;/b&gt; &amp;nbsp;(★ priorizado)&lt;table style=&quot;border-collapse:collapse;width:100%;margin-top:6px;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px&quot;&gt;ASR&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px&quot;&gt;Atributo&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px&quot;&gt;Alcance · artefacto (relleno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px&quot;&gt;Participa sin modificarse (contorno)&lt;/th&gt;&lt;th style=&quot;border-bottom:1.5px solid #3B4B5C;text-align:left;padding:4px 6px&quot;