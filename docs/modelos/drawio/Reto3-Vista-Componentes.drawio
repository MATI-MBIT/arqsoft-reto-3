 style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Interoperabilidad&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Conector empresa N · Registro de conectores y contratos&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Eventos canónicos&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;INT-01 interfaz común · INT-04 cdm · MOD-04 pub-sub&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;≤ 500 h-h desde la solicitud hasta que los datos están en la vista unificada&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#2C7873;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;I02&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Interoperabilidad&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Conector EPS · Conector empresa N · Registro de conectores y contratos · Cuarentena&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Eventos canónicos&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;INT-04 cdm · INT-01 interfaz común&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;≤ 80 h-h por empresa hasta que sus datos están en la vista unificada&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontFamily=Helvetica;fontSize=11;fontColor=#1F2A36;" vert