rpretado&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;INT-04 cdm · INT-01 interfaz común&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;≤ 80 h-h por empresa hasta que sus datos están en la vista unificada&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#5B3F8C;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;M01&lt;/span&gt; ★&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Modificabilidad&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;IngresosFacturadoMenosGlosado · ConfiguracionReglas · Activacion · Construida · Probada · Activa · Revertida&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;EntradaBitacora · RegistroInterpretado&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;MOD-09 ejecución · MOD-03 API estable versionada&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;≤ 24 h-h desde la solicitud hasta producción&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top;white-space:nowrap&quot;&gt;&lt;span style=&quot;background:#9A5B13;color:#fff;font-weight:bold;padding:1px 5px;border-radius:4px&quot;&gt;M02&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;Modificabilidad&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align:top&quot;&gt;TraductorEmpresaN · MapeoIPS&lt;/td&gt;&lt;td style=&quot;border-bottom:1px solid #D5DBE1;padding:4px 6px;vertical-align